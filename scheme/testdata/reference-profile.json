{
  "scheme": "prn",
  "uriSubset": {
    "allowQuery": false,
    "allowFragment": false,
    "allowUserinfo": false,
    "allowPort": false,
    "segmentPattern": "^[A-Za-z][A-Za-z0-9_-]*$"
  },
  "authorities": [
    {"name": "acme", "description": "Acme Corp — resourceref reference-profile fixture"},
    {"name": "opensource", "description": "Open Source Project — resourceref reference-profile fixture"}
  ],
  "shapes": [
    {
      "name": "tenant-scoped",
      "segments": [
        {"role": "app"},
        {"role": "org"},
        {"role": "resourceType"},
        {"role": "id"}
      ]
    },
    {
      "name": "ecosystem-artifact",
      "segments": [
        {"role": "resourceType"},
        {"role": "id", "rest": true}
      ]
    }
  ],
  "resourceTypes": [
